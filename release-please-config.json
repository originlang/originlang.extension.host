{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "oext",
      "components": [
        "oext",
        "originlang-ext-protocol",
        "originlang-ext-permission",
        "originlang-ext-manifest",
        "originlang-ext-storage",
        "originlang-ext-scheduler",
        "originlang-ext-session",
        "originlang-ext-runtime",
        "originlang-ext-runtime-quickjs",
        "originlang-ext-runtime-process",
        "originlang-ext-runtime-dylib",
        "originlang-ext-plugin-abi",
        "originlang-ext-signing",
        "originlang-ext-host",
        "originlang-ext-sandbox"
      ],
      "merge": false
    },
    {
      "type": "cargo-workspace",
      "merge": false
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "oext",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        }
      ]
    },
    "crates/protocol": {
      "release-type": "rust",
      "component": "originlang-ext-protocol",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/permission": {
      "release-type": "rust",
      "component": "originlang-ext-permission",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/manifest": {
      "release-type": "rust",
      "component": "originlang-ext-manifest",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/storage": {
      "release-type": "rust",
      "component": "originlang-ext-storage",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/scheduler": {
      "release-type": "rust",
      "component": "originlang-ext-scheduler",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/session": {
      "release-type": "rust",
      "component": "originlang-ext-session",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/runtime": {
      "release-type": "rust",
      "component": "originlang-ext-runtime",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/runtime-quickjs": {
      "release-type": "rust",
      "component": "originlang-ext-runtime-quickjs",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/runtime-process": {
      "release-type": "rust",
      "component": "originlang-ext-runtime-process",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/runtime-dylib": {
      "release-type": "rust",
      "component": "originlang-ext-runtime-dylib",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/plugin-abi": {
      "release-type": "rust",
      "component": "originlang-ext-plugin-abi",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/signing": {
      "release-type": "rust",
      "component": "originlang-ext-signing",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/host": {
      "release-type": "rust",
      "component": "originlang-ext-host",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "apps/sandbox": {
      "release-type": "rust",
      "component": "originlang-ext-sandbox",
      "skip-github-release": true,
      "skip-changelog": true
    }
  }
}
